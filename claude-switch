    else:
        c = '\033[38;2;217;119;87m'
    return f'{c}{\"█\" * filled}\033[2m{\"░\" * empty}\033[0m'

def get_profile_data(pname):
    p_cred = os.path.join(profiles_dir, pname, 'credentials.json')
    p_status = os.path.join(profiles_dir, pname, 'status.json')
    if pname == active_name:
        if os.path.exists(cred_file_root):
            p_cred = cred_file_root

    email = 'unknown'
    plan = 'unknown'
    org = ''
    token_status = 'unknown'
    access_token = None

    if os.path.exists(p_status):
        try:
            with open(p_status) as f:
                st = json.load(f)
            email = st.get('email', 'unknown')
            plan = st.get('subscriptionType', 'unknown')
            org = st.get('orgName', '')
        except Exception:
            pass

    if os.path.exists(p_cred):
        try:
            with open(p_cred) as f:
                d = json.load(f)
            oauth = d.get('claudeAiOauth', {})
            if email == 'unknown':
                email = oauth.get('email', 'unknown')
            if plan == 'unknown':
                plan = oauth.get('subscriptionType', 'unknown')
            if not org:
                org = oauth.get('organizationTitle') or oauth.get('organizationId', '')

            access_token = oauth.get('accessToken')
            ref_expires = oauth.get('refreshTokenExpiresAt', 0)
            expires = oauth.get('expiresAt', 0)
            now_ms = time.time() * 1000
            target_exp = ref_expires if ref_expires > 0 else expires
            if target_exp > now_ms:
                rem_days = (target_exp - now_ms) / 1000 / 86400
                if rem_days >= 1:
                    token_status = f'{rem_days:.0f}d'
                else:
                    rem_hrs = (target_exp - now_ms) / 1000 / 3600
                    token_status = f'{rem_hrs:.0f}h'
            else:
                token_status = 'expired'
        except Exception:
            pass

    # Fetch usage
    r1 = '\033[2musage: unavailable\033[0m'
    r2 = ''
    r3 = ''

    if not access_token:
        r1 = '\033[33musage: no token\033[0m'
        r2 = '\033[2m(run claude login)\033[0m'
    else:
        headers = {
            'Authorization': f'Bearer {access_token}',
            'User-Agent': 'claude-code/2.1.268',
            'Accept': 'application/json',
            'anthropic-client': 'claude-code/2.1.268'
        }
        req = urllib.request.Request('https://api.anthropic.com/api/oauth/usage', headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=5) as resp:
                u = json.loads(resp.read().decode())
                fh = u.get('five_hour', {})
                sd = u.get('seven_day', {})
                now_utc = datetime.datetime.now(datetime.timezone.utc)

                p_used = int(round(fh.get('utilization', 0)))
                p_str = fh.get('resets_at')
                p_time = 'unknown'
                p_rem = 0
                if p_str:
                    p_dt = datetime.datetime.fromisoformat(p_str)
                    p_rem = max(0, (p_dt - now_utc).total_seconds())
                    p_time = p_dt.astimezone().strftime('%-I:%M %p')

                s_used = int(round(sd.get('utilization', 0)))
                s_str = sd.get('resets_at')
                s_time = 'unknown'
                s_rem = 0
                if s_str:
                    s_dt = datetime.datetime.fromisoformat(s_str)
                    s_rem = max(0, (s_dt - now_utc).total_seconds())
                    s_time = s_dt.astimezone().strftime('%a %-I:%M %p')

                p_warn = ' \033[31m⚠\033[0m' if p_used >= 100 else (' \033[33m⚠\033[0m' if p_used >= 85 else '')
                r1 = f'5h [{make_bar(p_used)}] {p_used:>3}% \033[2m· {format_delta(p_rem)}\033[0m{p_warn}'

                s_warn = ' \033[31m⚠\033[0m' if s_used >= 100 else (' \033[33m⚠\033[0m' if s_used >= 85 else '')
                r2 = f'wk [{make_bar(s_used)}] {s_used:>3}% \033[2m· {format_delta(s_rem)}\033[0m{s_warn}'

                r3 = f'\033[2mresets {p_time} · {s_time}\033[0m'
        except urllib.error.HTTPError as e:
            if e.code == 401:
                r1 = '\033[33m⚡ usage: session expired\033[0m'
                r2 = '\033[2m(run claude login to refresh)\033[0m'
            elif e.code == 429:
                r1 = '\033[33m⚡ usage: rate limited\033[0m'
                r2 = '\033[2m(try again shortly)\033[0m'
            else:
                r1 = f'\033[31musage: http {e.code}\033[0m'
        except Exception as e:
            if 'timed out' in str(e).lower():
                r1 = '\033[2musage: timed out\033[0m'
            else:
                r1 = '\033[2musage: unavailable (offline)\033[0m'

    return {
        'name': pname,
        'email': email,
        'plan': plan,
        'org': org,
        'token_status': token_status,
        'is_active': (pname == active_name),
        'r1': r1,
        'r2': r2,
        'r3': r3,
    }

target = '$target'
if target == 'all' or not target:
    profiles = sorted([os.path.basename(p) for p in glob.glob(os.path.join(profiles_dir, '*')) if os.path.isdir(p)])
else:
    profiles = [target] if os.path.isdir(os.path.join(profiles_dir, target)) else []

if not profiles:
    sys.exit(0)

with ThreadPoolExecutor(max_workers=min(8, max(1, len(profiles)))) as pool:
    data_list = list(pool.map(get_profile_data, profiles))

left_w = 35
