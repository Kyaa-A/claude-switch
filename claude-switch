# ── Interactive Menu ───────────────────────────────────────────

# Pure bash interactive selector with arrow keys
# Usage: interactive_select "prompt" options[@]
# Returns: selected index in $SELECTED_INDEX, value in $SELECTED_VALUE
interactive_select() {
    local prompt="$1"
    shift
    local options=("$@")
    local count=${#options[@]}
    local selected=0

    if [[ $count -eq 0 ]]; then
        echo -e "  ${RED}${ICO_CROSS} No options available${RST}"
        return 1
    fi

    # Hide cursor
    echo -ne "$HIDE_CURSOR"

    # Trap to restore cursor on exit
    trap 'echo -ne "$SHOW_CURSOR"' EXIT INT TERM

    # Print prompt
    echo -e "  ${BOLD}${prompt}${RST}"
    echo -e "  ${DIM}Use ↑↓ arrows (or j/k) to navigate, Enter to select, q to cancel${RST}"
    echo ""

    # Initial render
    local i
    for ((i = 0; i < count; i++)); do
        if [[ $i -eq $selected ]]; then
            echo -e "  ${C2}${BOLD}${ICO_ARROW} ${options[$i]}${RST}"
        else
            echo -e "  ${DIM}  ${options[$i]}${RST}"
        fi
    done

    # Read input loop
    while true; do
        # Read single keypress
        IFS= read -rsn1 key

        case "$key" in
            $'\x1b')
                # Escape sequence (arrow key)
                read -rsn2 -t 0.01 rest
                case "$rest" in
                    '[A') # Up
                        ((selected > 0)) && ((selected--))
                        ;;
                    '[B') # Down
                        ((selected < count - 1)) && ((selected++))
                        ;;
                esac
                ;;
            'k') # vim up
                ((selected > 0)) && ((selected--))
                ;;
            'j') # vim down
                ((selected < count - 1)) && ((selected++))
                ;;
            '') # Enter
                break
                ;;
            'q'|'Q') # Quit
                echo -ne "$SHOW_CURSOR"
                # Move cursor past the menu
                echo ""
                echo -e "  ${DIM}Cancelled${RST}"
                return 1
                ;;
        esac

        # Redraw: move up and overwrite
        for ((i = 0; i < count; i++)); do
            echo -ne "\033[A${CLEAR_LINE}"
        done

        for ((i = 0; i < count; i++)); do
            if [[ $i -eq $selected ]]; then
                echo -e "  ${C2}${BOLD}${ICO_ARROW} ${options[$i]}${RST}"
            else
                echo -e "  ${DIM}  ${options[$i]}${RST}"
            fi
        done
    done

    # Show cursor
    echo -ne "$SHOW_CURSOR"
    echo ""

    SELECTED_INDEX=$selected
    SELECTED_VALUE="${options[$selected]}"
    return 0
}

# Simple text input prompt
input_prompt() {
    local prompt="$1" default="${2:-}"
    local result

    if [[ -n "$default" ]]; then
        echo -ne "  ${BOLD}${prompt}${RST} ${DIM}(${default})${RST}: "
    else
        echo -ne "  ${BOLD}${prompt}${RST}: "
    fi
    read -r result
    if [[ -z "$result" && -n "$default" ]]; then
        result="$default"
    fi
    echo "$result"
}

# Confirmation prompt
confirm() {
    local prompt="$1" default="${2:-y}"
    local yn

    if [[ "$default" == "y" ]]; then
        echo -ne "  ${BOLD}${prompt}${RST} ${DIM}[Y/n]${RST}: "
    else
        echo -ne "  ${BOLD}${prompt}${RST} ${DIM}[y/N]${RST}: "
    fi
    read -r yn
    yn="${yn:-$default}"
    [[ "$yn" =~ ^[Yy] ]]
}

