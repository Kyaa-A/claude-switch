# Print a profile card
print_profile_card() {
    local name="$1" email="$2" plan="$3" org="$4" is_active="$5" token_status="$6"
    local width=56

    local active_badge=""
    local name_color="$BWHITE"
    local border_color="$DIM"
    local tree_color="$DIM"
    if [[ "$is_active" == "true" ]]; then
        active_badge="  ${C2}${BOLD}⚡ ACTIVE${RST}"
        name_color="$C3"
        border_color="$C2"
        tree_color="$C4"
    fi

    # Token status badge
    local token_badge=""
    if [[ "$token_status" == expired ]]; then
        token_badge="  ${BRED}${BOLD}[EXPIRED]${RST}"
    elif [[ "$token_status" == unknown ]]; then
        token_badge="  ${GRAY}[?]${RST}"
    else
        local days="${token_status#valid:}"
        token_badge="  ${C5}${ICO_LOCK} ${days} remaining${RST}"
    fi

    echo -e "    ${border_color}┌$(repeat_char "─" $width)┐${RST}"
    echo -e "    ${border_color}│${RST}  ${name_color}${BOLD}${name}${RST}${active_badge}${token_badge}"
    echo -e "    ${border_color}│${RST}  ${tree_color}├─${RST} ${C5}email${RST}  ${BCYAN}${email}${RST}"
    echo -e "    ${border_color}│${RST}  ${tree_color}├─${RST} ${C5}plan${RST}   ${C3}${BOLD}${plan}${RST}"
    if [[ "$org" != "unknown" && -n "$org" ]]; then
        echo -e "    ${border_color}│${RST}  ${tree_color}└─${RST} ${C5}org${RST}    ${DIM}${org}${RST}"
    fi
    echo -e "    ${border_color}└$(repeat_char "─" $width)┘${RST}"
}

# Status message helpers — sqlmap style
msg_success() { echo -e "  ${BGREEN}${BOLD}[+]${RST} $*"; }
msg_error()   { echo -e "  ${BRED}${BOLD}[-]${RST} $*" >&2; }
msg_warn()    { echo -e "  ${BYELLOW}${BOLD}[!]${RST} $*"; }
msg_info()    { echo -e "  ${BCYAN}${BOLD}[*]${RST} $*"; }
msg_step()    { echo -e "  ${BMAGENTA}${BOLD}[>]${RST} $*"; }

# Spinner for async operations
spinner() {
    local pid="$1" message="${2:-Loading}"
    local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    local i=0

    echo -ne "$HIDE_CURSOR"
    while kill -0 "$pid" 2>/dev/null; do
        echo -ne "\r  ${MAGENTA}${frames[$i]}${RST} ${message}..."
        i=$(( (i + 1) % ${#frames[@]} ))
        sleep 0.08
    done
    echo -ne "\r${CLEAR_LINE}"
    echo -ne "$SHOW_CURSOR"
}

# ── Profile helpers ────────────────────────────────────────────

get_profile_names() {
    local profiles=()
    if [[ -d "$PROFILES_DIR" ]]; then
        for dir in "$PROFILES_DIR"/*/; do
            [[ -d "$dir" ]] || continue
            profiles+=("$(basename "$dir")")
        done
    fi
    echo "${profiles[@]}"
}

get_profile_info() {
    local name="$1"
    local status_file="$PROFILES_DIR/$name/status.json"
    local cred_file="$PROFILES_DIR/$name/credentials.json"

    PROF_EMAIL=$(json_get "$status_file" "email" "unknown")
    PROF_PLAN=$(json_get "$status_file" "subscriptionType" "unknown")
    PROF_ORG=$(json_get "$status_file" "orgName" "unknown")
    PROF_TOKEN=$(check_token_valid "$cred_file")
}

# ── Commands ───────────────────────────────────────────────────

cmd_save() {
    local name="${1:-}"

    show_mini_banner

    if [[ -z "$name" ]]; then
        # Interactive: ask for profile name
        echo -e "  ${BOLD}Save current session as a profile${RST}"
        echo ""
        name=$(input_prompt "${ICO_KEY} Profile name")
        if [[ -z "$name" ]]; then
            msg_error "Profile name cannot be empty"
            exit 1
        fi
    fi

    ensure_profiles_dir

    if [[ ! -f "$CRED_FILE" ]]; then
        msg_error "No credentials found at ${ULINE}${CRED_FILE}${RST}"
        msg_info "Login first: ${BOLD}claude auth login${RST}"
        exit 1
    fi

    # Check if profile already exists
    local profile_dir="$PROFILES_DIR/$name"
    if [[ -d "$profile_dir" ]]; then
        echo ""
        msg_warn "Profile ${BOLD}'$name'${RST} already exists"
        if ! confirm "Overwrite?" "y"; then
            echo ""
            msg_info "Cancelled"
            exit 0
        fi
    fi

    mkdir -p "$profile_dir"

    # Copy credentials
    cp "$CRED_FILE" "$profile_dir/credentials.json"

    # Save auth status
    if command -v claude &>/dev/null; then
        claude auth status --json 2>/dev/null > "$profile_dir/status.json" || true
    fi

    # Mark as active
    echo "$name" > "$ACTIVE_FILE"

    echo ""
    msg_success "Profile ${BOLD}${BGREEN}'$name'${RST} saved!"
    echo ""

    # Show card
    get_profile_info "$name"
    print_profile_card "$name" "$PROF_EMAIL" "$PROF_PLAN" "$PROF_ORG" "true" "$PROF_TOKEN"
    echo ""
}

cmd_use() {
    local name="${1:-}"

    show_mini_banner
    ensure_profiles_dir

    # Get available profiles
    local profile_arr=()
    read -ra profile_arr <<< "$(get_profile_names)"

    if [[ ${#profile_arr[@]} -eq 0 ]]; then
        msg_warn "No profiles saved yet"
        echo ""
        msg_info "Save your current session first:"
        echo -e "    ${BOLD}claude-switch save <name>${RST}"
        exit 1
    fi

    local active
    active=$(get_active_profile)

    if [[ -z "$name" ]]; then
        # Interactive mode: show selection menu
        local display_options=()
        for p in "${profile_arr[@]}"; do
            get_profile_info "$p"
            local marker=""
            if [[ "$p" == "$active" ]]; then
                marker=" ${GREEN}(active)${RST}"
            fi
            display_options+=("${BOLD}${p}${RST}  ${DIM}${PROF_EMAIL}  [${PROF_PLAN}]${RST}${marker}")
        done

        if interactive_select "${ICO_SWAP} Select account to switch to:" "${display_options[@]}"; then
            name="${profile_arr[$SELECTED_INDEX]}"
        else
            exit 0
        fi
    fi

    # Validate profile exists
    local profile_dir="$PROFILES_DIR/$name"
    if [[ ! -f "$profile_dir/credentials.json" ]]; then
        msg_error "Profile ${BOLD}'$name'${RST} not found!"
        echo ""
        cmd_list_compact
        exit 1
    fi

    # Already active?
    if [[ "$name" == "$active" ]]; then
        msg_info "Already on profile ${BOLD}'$name'${RST}"
        exit 0
    fi

    # Auto-save current credentials before switching
    if [[ -n "$active" && -f "$CRED_FILE" ]]; then
        local current_dir="$PROFILES_DIR/$active"
        mkdir -p "$current_dir"
        cp "$CRED_FILE" "$current_dir/credentials.json"
        if command -v claude &>/dev/null; then
            claude auth status --json 2>/dev/null > "$current_dir/status.json" || true
        fi
        msg_info "Auto-saved current profile '${BOLD}${active}${RST}'"
    fi

    # Switch
    cp "$profile_dir/credentials.json" "$CRED_FILE"
    echo "$name" > "$ACTIVE_FILE"

    echo ""
    msg_success "Switched to ${BOLD}${BGREEN}'$name'${RST}!"
    echo ""

    # Show card
    get_profile_info "$name"
    print_profile_card "$name" "$PROF_EMAIL" "$PROF_PLAN" "$PROF_ORG" "true" "$PROF_TOKEN"
    echo ""
}

cmd_list() {
    show_mini_banner
    ensure_profiles_dir

    local active
    active=$(get_active_profile)

    local profile_arr=()
    read -ra profile_arr <<< "$(get_profile_names)"

    if [[ ${#profile_arr[@]} -eq 0 ]]; then
        echo -e "  ${DIM}No profiles saved yet.${RST}"
        echo ""
        echo -e "  ${BOLD}Quick start:${RST}"
        echo -e "    ${CYAN}1.${RST} ${BOLD}claude-switch save <name>${RST}    ${DIM}# save current session under any name${RST}"
        echo -e "    ${CYAN}2.${RST} ${BOLD}claude-switch login${RST}          ${DIM}# login to another account${RST}"
        echo -e "    ${CYAN}3.${RST} ${BOLD}claude-switch save <name>${RST}    ${DIM}# save that one under any name${RST}"
        echo -e "    ${CYAN}4.${RST} ${BOLD}claude-switch use <name>${RST}     ${DIM}# switch anytime!${RST}"
        echo ""
        return
    fi

    echo -e "  ${BOLD}${ICO_KEY} Saved Profiles${RST} ${DIM}(${#profile_arr[@]} total)${RST}"
    echo ""

    for pname in "${profile_arr[@]}"; do
        local is_active="false"
        [[ "$pname" == "$active" ]] && is_active="true"

        get_profile_info "$pname"
        print_profile_card "$pname" "$PROF_EMAIL" "$PROF_PLAN" "$PROF_ORG" "$is_active" "$PROF_TOKEN"
        echo ""
    done
}

cmd_list_compact() {
    local active
    active=$(get_active_profile)

    local profile_arr=()
    read -ra profile_arr <<< "$(get_profile_names)"

    echo -e "  ${BOLD}Available profiles:${RST}"
    for pname in "${profile_arr[@]}"; do
        local marker="  ${DIM}${ICO_RING}${RST}"
        [[ "$pname" == "$active" ]] && marker="  ${GREEN}${ICO_DOT}${RST}"

        get_profile_info "$pname"
        echo -e "  ${marker} ${BOLD}${pname}${RST}  ${DIM}${PROF_EMAIL}${RST}"
    done
}

cmd_status() {
    show_mini_banner

    local active
    active=$(get_active_profile)

    if [[ -z "$active" ]]; then
        msg_info "No active profile tracked"
        msg_info "Save your current session: ${BOLD}claude-switch save <name>${RST}"
        echo ""
        return
    fi

    echo -e "  ${BOLD}${ICO_BOLT} Current Session${RST}"
    echo ""

    get_profile_info "$active"
    print_profile_card "$active" "$PROF_EMAIL" "$PROF_PLAN" "$PROF_ORG" "true" "$PROF_TOKEN"

    # Live verification
    echo ""
    msg_step "Verifying with Claude API..."
    if command -v claude &>/dev/null; then
        local live_status
        live_status=$(claude auth status --json 2>/dev/null || echo '{}')
        local live_email
        live_email=$(echo "$live_status" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('email','?'))" 2>/dev/null || echo "?")
        local logged_in
        logged_in=$(echo "$live_status" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('loggedIn', False))" 2>/dev/null || echo "False")

        if [[ "$logged_in" == "True" ]]; then
            msg_success "Session is ${BOLD}${GREEN}valid${RST} — logged in as ${CYAN}${live_email}${RST}"
        else
            msg_error "Session is ${BOLD}${RED}invalid${RST} — token may have expired"
            msg_info "Try: ${BOLD}claude auth login${RST} then ${BOLD}claude-switch save ${active}${RST}"
        fi
    fi
    echo ""
}

cmd_delete() {
    local name="${1:-}"

    show_mini_banner
    ensure_profiles_dir

    if [[ -z "$name" ]]; then
        # Interactive: select profile to delete
        local profile_arr=()
        read -ra profile_arr <<< "$(get_profile_names)"

        if [[ ${#profile_arr[@]} -eq 0 ]]; then
            msg_warn "No profiles to delete"
            exit 0
        fi

        local display_options=()
        for p in "${profile_arr[@]}"; do
            get_profile_info "$p"
            display_options+=("${BOLD}${p}${RST}  ${DIM}${PROF_EMAIL}${RST}")
        done

        if interactive_select "${ICO_CROSS} Select profile to delete:" "${display_options[@]}"; then
            name="${profile_arr[$SELECTED_INDEX]}"
        else
            exit 0
        fi
    fi

    local profile_dir="$PROFILES_DIR/$name"
    if [[ ! -d "$profile_dir" ]]; then
        msg_error "Profile ${BOLD}'$name'${RST} not found!"
        exit 1
    fi

    # Confirm
    echo ""
    get_profile_info "$name"
    print_profile_card "$name" "$PROF_EMAIL" "$PROF_PLAN" "$PROF_ORG" "false" "$PROF_TOKEN"
    echo ""

    if ! confirm "${RED}Delete this profile?${RST}" "n"; then
        msg_info "Cancelled"
        exit 0
    fi

    local active
    active=$(get_active_profile)
    if [[ "$name" == "$active" ]]; then
        rm -f "$ACTIVE_FILE"
    fi

    rm -rf "$profile_dir"
    echo ""
    msg_success "Profile ${BOLD}'$name'${RST} deleted"
    echo ""
}

cmd_rename() {
    local old_name="${1:-}"
    local new_name="${2:-}"

    show_mini_banner
    ensure_profiles_dir

    local profile_arr=()
    read -ra profile_arr <<< "$(get_profile_names)"

    if [[ ${#profile_arr[@]} -eq 0 ]]; then
        msg_warn "No profiles to rename"
        exit 0
    fi

    if [[ -z "$old_name" ]]; then
        local display_options=()
        for p in "${profile_arr[@]}"; do
            get_profile_info "$p"
            display_options+=("${BOLD}${p}${RST}  ${DIM}${PROF_EMAIL}${RST}")
        done

        if interactive_select "${ICO_STAR} Select profile to rename:" "${display_options[@]}"; then
            old_name="${profile_arr[$SELECTED_INDEX]}"
        else
            exit 0
        fi
    fi

    local old_dir="$PROFILES_DIR/$old_name"
    if [[ ! -d "$old_dir" ]]; then
        msg_error "Profile ${BOLD}'$old_name'${RST} not found!"
        exit 1
    fi

    if [[ -z "$new_name" ]]; then
        echo ""
        new_name=$(input_prompt "New name for '${old_name}'" "")
        if [[ -z "$new_name" ]]; then
            msg_error "New profile name cannot be empty"
            exit 1
        fi
    fi

    local new_dir="$PROFILES_DIR/$new_name"
    if [[ -d "$new_dir" ]]; then
        msg_error "Profile ${BOLD}'$new_name'${RST} already exists!"
        exit 1
    fi

    mv "$old_dir" "$new_dir"

    local active
    active=$(get_active_profile)
    if [[ "$old_name" == "$active" ]]; then
        echo "$new_name" > "$ACTIVE_FILE"
    fi

    echo ""
    msg_success "Renamed profile ${BOLD}'$old_name'${RST} to ${BOLD}${BGREEN}'$new_name'${RST}"
    echo ""
}

cmd_login() {
    show_mini_banner
    ensure_profiles_dir

    echo -e "  ${BOLD}${ICO_KEY} Add a new account${RST}"
    echo ""

    local active
    active=$(get_active_profile)

    # Auto-save current session if exists so you NEVER lose it!
    if [[ -f "$CRED_FILE" ]]; then
        if [[ -n "$active" ]]; then
            local current_dir="$PROFILES_DIR/$active"
            mkdir -p "$current_dir"
            cp "$CRED_FILE" "$current_dir/credentials.json"
            if command -v claude &>/dev/null; then
                claude auth status --json 2>/dev/null > "$current_dir/status.json" || true
            fi
            msg_info "Current profile '${BOLD}${active}${RST}' auto-saved"
            echo ""
        else
            # Existing unsaved login detected — protect it first!
            msg_warn "Existing active Claude session detected!"
            msg_info "Saving your current session first so you don't lose it..."
            echo ""
            local prev_name
            prev_name=$(input_prompt "Name for your current logged-in account" "work")
            prev_name="${prev_name:-work}"
            cmd_save "$prev_name"
            echo ""
        fi
    fi

    msg_step "Opening Claude login..."
    echo ""

    # Run claude auth login
    claude auth login

    echo ""

    # Ask for profile name
    local name
    name=$(input_prompt "${ICO_KEY} Save new account as" "")
    if [[ -n "$name" ]]; then
        cmd_save "$name"
    else
        msg_info "Skipped saving. You can save later with: ${BOLD}claude-switch save <name>${RST}"
    fi
}

