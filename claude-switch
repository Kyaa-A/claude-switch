cmd_status() {
    show_mini_banner

    local active
    active=$(get_active_profile)

    if [[ -z "$active" ]]; then
        msg_info "No active profile tracked"
        msg_info "Save your current session: ${BOLD}claude-switch save <name>${RST}"
        echo ""
        return
    fi

    echo -e "  ${BOLD}${ICO_BOLT} Current Session${RST}"
    echo ""

    render_profile_cards "$active"

    # Live verification
    msg_step "Verifying with Claude API..."
    if command -v claude &>/dev/null; then
        local live_status
        live_status=$(claude auth status --json 2>/dev/null || echo '{}')
        local live_email
        live_email=$(echo "$live_status" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('email','?'))" 2>/dev/null || echo "?")
        local logged_in
        logged_in=$(echo "$live_status" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('loggedIn', False))" 2>/dev/null || echo "False")

        if [[ "$logged_in" == "True" ]]; then
            msg_success "Session is ${BOLD}${GREEN}valid${RST} — logged in as ${CYAN}${live_email}${RST}"
        else
            msg_error "Session is ${BOLD}${RED}invalid${RST} — token may have expired"
            msg_info "Try: ${BOLD}claude auth login${RST} then ${BOLD}claude-switch save ${active}${RST}"
        fi
    fi
    echo ""
}

cmd_usage() {
    local target="${1:-}"
    show_mini_banner
    ensure_profiles_dir

    local active
    active=$(get_active_profile)

    if [[ -z "$target" ]]; then
        target="$active"
    fi

    if [[ "$target" == "all" ]]; then
        local profile_arr=()
        read -ra profile_arr <<< "$(get_profile_names)"
        for p in "${profile_arr[@]}"; do
            local cred_file="$PROFILES_DIR/$p/credentials.json"
            get_profile_info "$p"
            local is_act="false"
            [[ "$p" == "$active" ]] && is_act="true"
            print_profile_card "$p" "$PROF_EMAIL" "$PROF_PLAN" "$PROF_ORG" "$is_act" "$PROF_TOKEN"
            echo ""
            show_claude_usage "$p" "$cred_file"
            echo ""
        done
        return
    fi

    if [[ -z "$target" ]]; then
        msg_error "No active profile tracked. Specify profile: claude-switch usage <name>"
        return 1
    fi

    local cred_file="$PROFILES_DIR/$target/credentials.json"
    if [[ ! -f "$cred_file" ]]; then
        msg_error "Profile '$target' not found!"
        return 1
    fi

    get_profile_info "$target"
    local is_act="false"
    [[ "$target" == "$active" ]] && is_act="true"
    print_profile_card "$target" "$PROF_EMAIL" "$PROF_PLAN" "$PROF_ORG" "$is_act" "$PROF_TOKEN"
