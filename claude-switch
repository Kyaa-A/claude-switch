    show_banner

    echo -e "  ${BOLD}USAGE${RST}"
    echo -e "    ${BWHITE}claude-switch${RST} ${DIM}[command] [options]${RST}"
    echo ""
    echo -e "  ${BOLD}COMMANDS${RST}"
    echo ""
    echo -e "    ${BCYAN}save${RST} ${DIM}<name>${RST}          Save current login as a named profile"
    echo -e "    ${BCYAN}use${RST} ${DIM}[name]${RST}           Switch to a saved profile (interactive if omitted)"
    echo -e "    ${BCYAN}list${RST}                List all saved profiles with details"
    echo -e "    ${BCYAN}rename${RST} ${DIM}[old] [new]${RST}   Rename a saved profile"
    echo -e "    ${BCYAN}status${RST}              Show active profile + live verification"
    echo -e "    ${BCYAN}login${RST}               Login to a new account and save it"
    echo -e "    ${BCYAN}delete${RST} ${DIM}[name]${RST}        Delete a saved profile (interactive if omitted)"
    echo -e "    ${BCYAN}help${RST}                Show this help message"
    echo ""
    echo -e "  ${BOLD}QUICK START${RST}"
    echo ""
    echo -e "    ${GRAY}# Step 1: Save current login under any name you want${RST}"
    echo -e "    ${GREEN}\$${RST} claude-switch save <name>"
    echo ""
    echo -e "    ${GRAY}# Step 2: Login to another account${RST}"
    echo -e "    ${GREEN}\$${RST} claude-switch login"
