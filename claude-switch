# Repeat a string N times
repeat_char() {
    local char="$1" count="$2"
    printf "%0.s${char}" $(seq 1 "$count")
}

# Print centered text
center() {
    local text="$1" width="${2:-$TERM_WIDTH}"
    # Strip ANSI codes to get real length
    local stripped
    stripped=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local len=${#stripped}
    local pad=$(( (width - len) / 2 ))
    [[ $pad -lt 0 ]] && pad=0
    printf "%${pad}s" ""
    echo -e "$text"
}

# Draw a horizontal rule
hr() {
    local char="${1:-─}" color="${2:-$DIM}"
    local width=$((TERM_WIDTH > 60 ? 60 : TERM_WIDTH))
    echo -e "${color}$(repeat_char "$char" "$width")${RST}"
}

# Extract field from JSON using python3 (available on most systems)
json_get() {
    local file="$1" field="$2" default="${3:-unknown}"
    if [[ -f "$file" ]] && command -v python3 &>/dev/null; then
        python3 -c "
import json
try:
    with open('$file') as f:
        d = json.load(f)
    print(d.get('$field', '$default'))
except:
    print('$default')
" 2>/dev/null
    else
        echo "$default"
    fi
}

# Check if credentials are still valid (token not expired)
check_token_valid() {
    local cred_file="$1"
    if [[ -f "$cred_file" ]] && command -v python3 &>/dev/null; then
        python3 -c "
import json, time
try:
    with open('$cred_file') as f:
        d = json.load(f)
    oauth = d.get('claudeAiOauth', {})
    ref_expires = oauth.get('refreshTokenExpiresAt', 0)
    expires = oauth.get('expiresAt', 0)
    now = time.time() * 1000
    target = ref_expires if ref_expires > 0 else expires
    if target > now:
        remaining_days = (target - now) / 1000 / 86400
        if remaining_days >= 1:
            print(f'valid:{remaining_days:.0f}d')
        else:
            remaining_hours = (target - now) / 1000 / 3600
            print(f'valid:{remaining_hours:.0f}h')
    else:
        print('expired')
except:
    print('unknown')
" 2>/dev/null
    else
        echo "unknown"
    fi
}

# Fetch and display live quota & rate limits for a Claude profile
show_claude_usage() {
    local prof_name="$1"
    local cred_file="$2"

    if [[ ! -f "$cred_file" ]]; then
        msg_error "Credentials file for '$prof_name' not found"
        return 1
    fi

    if ! command -v python3 &>/dev/null; then
        msg_warn "python3 required to query live usage"
        return 1
    fi

    python3 -c "
import json, time, datetime, urllib.request, urllib.error

def format_delta(seconds):
    if seconds <= 0:
        return 'now'
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    d, h = divmod(h, 24)
    parts = []
    if d > 0:
        parts.append(f'{d}d')
    if h > 0 or d > 0:
        parts.append(f'{h}h')
    parts.append(f'{m}m')
    return ' '.join(parts)

def color_bar(percent, width=22):
    percent = max(0, min(100, percent))
    filled = int(round((percent / 100.0) * width))
    empty = width - filled
    if percent >= 90:
        c = '\033[38;2;239;68;68m'
    elif percent >= 70:
        c = '\033[38;2;245;158;11m'
    else:
        c = '\033[38;2;217;119;87m'
    return f'{c}{\"█\" * filled}\033[2m{\"░\" * empty}\033[0m'

try:
    with open('$cred_file') as f:
        d = json.load(f)
    token = d.get('claudeAiOauth', {}).get('accessToken')
    if not token:
        print('  \033[33m[!] No access token available for this profile\033[0m')
        exit(0)

    headers = {
        'Authorization': f'Bearer {token}',
        'User-Agent': 'claude-code/2.1.268',
        'Accept': 'application/json',
        'anthropic-client': 'claude-code/2.1.268'
    }

    req = urllib.request.Request('https://api.anthropic.com/api/oauth/usage', headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            u = json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        if e.code == 401:
            print('  \033[31m[-] Session expired (HTTP 401). Re-login needed for this profile.\033[0m')
        else:
            print(f'  \033[31m[-] Usage query failed: HTTP {e.code}\033[0m')
        exit(0)
    except Exception as e:
        print(f'  \033[31m[-] Usage query network error: {e}\033[0m')
        exit(0)

    fh = u.get('five_hour', {})
    sd = u.get('seven_day', {})
    now_utc = datetime.datetime.now(datetime.timezone.utc)

    p_used = int(round(fh.get('utilization', 0)))
    p_str = fh.get('resets_at')
    p_time = 'unknown'
    p_rem = 0
    if p_str:
        p_dt = datetime.datetime.fromisoformat(p_str)
        p_rem = max(0, (p_dt - now_utc).total_seconds())
        p_time = p_dt.astimezone().strftime('%-I:%M %p')

    s_used = int(round(sd.get('utilization', 0)))
    s_str = sd.get('resets_at')
    s_time = 'unknown'
    s_rem = 0
    if s_str:
        s_dt = datetime.datetime.fromisoformat(s_str)
        s_rem = max(0, (s_dt - now_utc).total_seconds())
        s_time = s_dt.astimezone().strftime('%a %-I:%M %p')

    print(f'  \033[1m📊 Quota & Rate Limits\033[0m \033[2m($prof_name)\033[0m')
    print('    \033[2m┌────────────────────────────────────────────────────────┐\033[0m')
    p_warn = '  \033[31m⚠ limit reached\033[0m' if p_used >= 100 else ('  \033[33m⚠ high\033[0m' if p_used >= 85 else '')
    print(f'    \033[2m│\033[0m  \033[1m5-Hour Limit:\033[0m   {p_used:>2}% used{p_warn}')
    print(f'    \033[2m│\033[0m  [{color_bar(p_used)}] \033[2mresets in {format_delta(p_rem)} ({p_time})\033[0m')
    print('    \033[2m│\033[0m')
    s_warn = '  \033[31m⚠ limit reached\033[0m' if s_used >= 100 else ('  \033[33m⚠ high\033[0m' if s_used >= 85 else '')
    print(f'    \033[2m│\033[0m  \033[1mWeekly Limit:\033[0m   {s_used:>2}% used{s_warn}')
    print(f'    \033[2m│\033[0m  [{color_bar(s_used)}] \033[2mresets in {format_delta(s_rem)} ({s_time})\033[0m')
    print('    \033[2m└────────────────────────────────────────────────────────┘\033[0m')
except Exception as e:
    pass
" 2>/dev/null
}

