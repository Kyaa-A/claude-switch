# Status message helpers — sqlmap style
msg_success() { echo -e "  ${BGREEN}${BOLD}[+]${RST} $*"; }
msg_error()   { echo -e "  ${BRED}${BOLD}[-]${RST} $*" >&2; }
msg_warn()    { echo -e "  ${BYELLOW}${BOLD}[!]${RST} $*"; }
msg_info()    { echo -e "  ${BCYAN}${BOLD}[*]${RST} $*"; }
msg_step()    { echo -e "  ${BMAGENTA}${BOLD}[>]${RST} $*"; }

# Spinner for async operations
spinner() {
    local pid="$1" message="${2:-Loading}"
    local frames=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
    local i=0

    echo -ne "$HIDE_CURSOR"
    while kill -0 "$pid" 2>/dev/null; do
        echo -ne "\r  ${MAGENTA}${frames[$i]}${RST} ${message}..."
        i=$(( (i + 1) % ${#frames[@]} ))
        sleep 0.08
    done
    echo -ne "\r${CLEAR_LINE}"
    echo -ne "$SHOW_CURSOR"
}

