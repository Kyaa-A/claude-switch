    echo -e "    ${GRAY}# Step 3: Switch between them anytime${RST}"
    echo -e "    ${GREEN}\$${RST} claude-switch use <name>"
    echo ""
    echo -e "    ${GRAY}# Or launch the interactive arrow-key picker:${RST}"
    echo -e "    ${GREEN}\$${RST} claude-switch use"
    echo ""
    echo -e "  ${BOLD}HOW IT WORKS${RST}"
    echo ""
    echo -e "    Swaps ${ULINE}~/.claude/.credentials.json${RST} between saved snapshots."
    echo -e "    ${GREEN}${ICO_CHECK}${RST} No logout required    ${GREEN}${ICO_CHECK}${RST} Zero dependencies"
    echo -e "    ${GREEN}${ICO_CHECK}${RST} Auto-saves on switch  ${GREEN}${ICO_CHECK}${RST} Token expiry tracking"
    echo ""
}

# Interactive mode (no args or just 'claude-switch')
cmd_interactive() {
    show_banner
    ensure_profiles_dir

    local options=(
        "${ICO_SWAP}  Switch account"
        "${ICO_KEY}  Save current session"
        "${ICO_USER}  Login new account"
        "${ICO_DOT}  List all profiles"
        "${ICO_STAR}  Rename a profile"
        "${ICO_BOLT}  Check status"
        "${ICO_CROSS}  Delete a profile"
    )

    if interactive_select "What would you like to do?" "${options[@]}"; then
        echo ""
        case $SELECTED_INDEX in
            0) cmd_use ;;
            1) cmd_save ;;
            2) cmd_login ;;
            3) cmd_list ;;
            4) cmd_rename ;;
            5) cmd_status ;;
            6) cmd_delete ;;
        esac
    fi
}

# ── Main dispatch ──────────────────────────────────────────────

main() {
    case "${1:-}" in
        save)          cmd_save "${2:-}" ;;
        use|switch)    cmd_use "${2:-}" ;;
        list|ls)       cmd_list ;;
        rename|mv)     cmd_rename "${2:-}" "${3:-}" ;;
        status|whoami) cmd_status ;;
        delete|rm)     cmd_delete "${2:-}" ;;
        login|add)     cmd_login ;;
        help|--help|-h) cmd_help ;;
        --version|-v)  echo "claude-switch v${VERSION}" ;;
        "")            cmd_interactive ;;
        *)
            msg_error "Unknown command: ${BOLD}$1${RST}"
            echo ""
            echo -e "  Run ${BOLD}claude-switch help${RST} for usage"
            exit 1
            ;;
    esac
}

main "$@"
